# MINIDEV_IMAGE_PATH="/path/to/portable-gpu-runtime-12.1.ext4"
# MINIDEV_MOUNT="/mnt/codex-gpu-runtime"
# MINIDEV_IMGIT_REPO="/path/to/ImGit-master"
# MINIDEV_VISION_REPO="/path/to/codex-ai-vision-inspection"
