# Copy to gpu-driver-cache/minidev.conf; do not commit local credentials.
# MINIDEV_SOCKS_PROXY="socks5h://127.0.0.1:7897"
# MINIDEV_APT_PROXY="http://127.0.0.1:7897"
# MINIDEV_IMAGE_URL="https://your-storage.example/portable-gpu-runtime-12.1.ext4"
